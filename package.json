{
  "name": "obsidian-spotlight-slides",
  "version": "0.0.3",
  "description": "Present any note as slides.",
  "author": {
    "name": "the-spanish-guy",
    "url": "https://github.com/the-spanish-guy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-spanish-guy/obsidian-spotlight-slides.git"
  },
  "bugs": {
    "url": "https://github.com/the-spanish-guy/obsidian-spotlight-slides/issues"
  },
  "homepage": "https://github.com/the-spanish-guy/obsidian-spotlight-slides#readme",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "slides",
    "presentation",
    "marp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@marp-team/marp-core": "4.4.0"
  },
  "overrides": {
    "katex": "0.19.1",
    "@xmldom/xmldom": "0.9.12"
  }
}
