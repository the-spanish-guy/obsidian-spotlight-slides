    "lint": "eslint .",
    "test": "vitest run"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@marp-team/marp-core": "4.4.0"
  }
}
