{
  "name": "obsidian-spotlight-slides",
  "version": "0.0.1",
  "description": "Present any note as slides inside Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
